# ==========================================
# Variables de Entorno — Iglesia Esperanza de Vida
# ==========================================

# Supabase (Auth y Data API). Usa la publishable key del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
# Compatibilidad temporal con proyectos que todavía usan la clave anon antigua.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Activa solo para revisar datos sintéticos en un entorno local o de preview.
NEXT_PUBLIC_ADMIN_DEMO_MODE=false

# Vercel / Despliegue
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MapLibre / Maptiler (Opcional si se usa vector tiles personalizados)
NEXT_PUBLIC_MAPTILER_KEY=
